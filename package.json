{
  "name": "time2live",
  "version": "0.1.0",
  "description": "Scheduling and liveness (TTL) service for autonomous AI agents",
  "scripts": {
    "dev:api": "tsx watch src/bin/api.ts",
    "dev:worker": "tsx watch src/bin/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/bin/api.js",
    "start:worker": "node dist/bin/worker.js",
    "migrate": "tsx src/bin/migrate.ts",
    "migrate:prod": "node dist/bin/migrate.js",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "admin": "tsx src/bin/admin.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeMikko/TTL.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/MeMikko/TTL/issues"
  },
  "homepage": "https://github.com/MeMikko/TTL#readme",
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/mcp": "^2.28.0",
    "cron-parser": "^5.10.1",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.11",
    "ipaddr.js": "^2.5.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "undici": "^8.11.2",
    "viem": "^2.57.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@x402/fetch": "^2.28.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
