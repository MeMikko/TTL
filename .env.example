# Copy to .env and adjust. Never commit the real .env.
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
DATABASE_URL=postgres://t2l:t2l@localhost:5432/time2live
PUBLIC_BASE_URL=http://localhost:3000
WORKER_TICK_INTERVAL_MS=15000
HEALTH_MAX_TICK_AGE_MS=120000

# Set to true only behind our own reverse proxy (Caddy in production).
TRUST_PROXY=false
# Chains accepted for Sign-In with Ethereum (Base mainnet, Base Sepolia).
SIWE_CHAIN_IDS=8453,84532
SIWE_NONCE_TTL_SECONDS=300
# Optional: enables smart-wallet (ERC-1271/6492) signature verification.
# BASE_RPC_URL=https://mainnet.base.org
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
MAX_API_KEYS_PER_ACCOUNT=20
RATE_LIMIT_IP_PER_MIN=120
RATE_LIMIT_AUTH_IP_PER_MIN=10
RATE_LIMIT_KEY_PER_MIN=300

# AES-256-GCM key for secrets at rest (job headers, webhook signing secrets).
# Generate: openssl rand -base64 32   (or: node -e "console.log(crypto.randomBytes(32).toString('base64'))")
# The value below is for LOCAL DEVELOPMENT ONLY.
ENCRYPTION_KEY=ZGV2LW9ubHktZGV2LW9ubHktZGV2LW9ubHktZGV2LTE=
# Comma-separated public IPs of this server; webhook targets may never point at them.
SERVER_PUBLIC_IPS=
# Development only (refused in production): allow http/any port/private webhook targets.
WEBHOOK_DEV_ALLOW_LOCAL=true
TARGET_HOST_RATE_PER_MIN=60
DELIVERY_CONCURRENCY=20
SCHEDULER_POLL_MS=1000
MAX_JOBS_PER_ACCOUNT=100

# Pings per monitor per minute.
RATE_LIMIT_PING_PER_MIN=60
# Optional Telegram alerts (create a bot with @BotFather). All three are required together.
# After deploy, register the webhook once: node dist/bin/admin.js telegram-webhook
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=   # 16-256 chars of A-Z a-z 0-9 _ -  (openssl rand -hex 32)

# x402 payments (USDC on Base). Off: quotas still apply and over-quota calls get a plain 402.
# The public x402.org facilitator serves testnets only (eip155:84532 = Base Sepolia).
# Base mainnet (eip155:8453) needs another facilitator, e.g. Coinbase CDP, plus its auth header.
# X402_ENABLED=true
# X402_NETWORK=eip155:84532
# X402_PAY_TO=0xYourReceivingWallet
# X402_FACILITATOR_URL=https://x402.org/facilitator
# X402_FACILITATOR_AUTHORIZATION=Bearer …
