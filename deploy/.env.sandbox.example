# /opt/time2live-sandbox/.env — the public testnet SANDBOX instance (testnet.time2live.xyz).
# A second Docker Compose stack on the same host as production, pointed at Base Sepolia.
# chmod 600, owned by the deploy user. NEVER commit it. See docs/OPERATIONS.md §11.

IMAGE=time2live
IMAGE_TAG=
# DOCKER_BUILD_FLAGS=

DOMAIN=testnet.time2live.xyz
ACME_EMAIL=you@example.com
PUBLIC_BASE_URL=https://testnet.time2live.xyz

# Sandbox: labels every surface as a sandbox and wipes all account data on a rolling TTL so the
# instance can't be used as a free production backend. x402 stays ON below (testnet USDC).
SANDBOX=true
SANDBOX_DATA_TTL_HOURS=168     # 7 days
HISTORY_RETENTION_DAYS=7

# Tighter quotas than production (defeats real workloads, fine for integration tests).
MAX_JOBS_PER_ACCOUNT=10
RATE_LIMIT_IP_PER_MIN=60
RATE_LIMIT_KEY_PER_MIN=60
RATE_LIMIT_PING_PER_MIN=30

# Analytics off on the sandbox (empty disables it).
ANALYTICS_ADDRESS=

# Its OWN database (separate stack / volume from production).
POSTGRES_USER=time2live
POSTGRES_DB=time2live_sandbox
# hex only: openssl rand -hex 32
POSTGRES_PASSWORD=

# openssl rand -base64 32 — a sandbox secret, distinct from production's.
ENCRYPTION_KEY=

LOG_LEVEL=info
SERVER_PUBLIC_IPS=
SIWE_CHAIN_IDS=84532,8453
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# x402 on Base Sepolia with the FREE public facilitator — payments settle in testnet USDC, so the
# whole payment path is exercised end to end at no real cost. No CDP key needed on testnet.
X402_ENABLED=true
X402_NETWORK=eip155:84532
X402_PAY_TO=0xYourTestnetReceivingWallet
X402_FACILITATOR_URL=https://x402.org/facilitator

# Keeper on Base Sepolia. Deploy the current (audit-v1) factory to Sepolia and put its address here;
# fund KEEPER_PRIVATE_KEY from a Sepolia faucet (free). See docs/OPERATIONS.md §8c / §11.
KEEPER_ENABLED=true
KEEPER_CHAIN_ID=84532
KEEPER_RPC_URL=https://sepolia.base.org
KEEPER_FACTORY_ADDRESS=0x…
KEEPER_FROM_BLOCK=0
KEEPER_PRIVATE_KEY=0x…
# Free-tier RPCs cap eth_getLogs ranges; lower the scan chunk if you see a range error.
# KEEPER_LOG_CHUNK=10

# Dogfooding: point the sandbox's self-heartbeat at its own ping URL.
# SELF_HEARTBEAT_URL=https://testnet.time2live.xyz/v1/heartbeat/mon_…
