{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Caddy is the edge: it replaces any client-supplied X-Forwarded-For with the real peer
	# address, which the api reads (TRUST_PROXY=true).
	reverse_proxy api:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output stdout
		format json
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
