# /opt/time2live/.env on the server (chmod 600, owned by the deploy user). NEVER commit it.
# Generate secrets with: openssl rand -hex 32   /   openssl rand -base64 32

# Managed by remote-deploy.sh (locally built image and the commit currently running).
IMAGE=time2live
IMAGE_TAG=
# Optional extra `docker build` flags for server-side builds (e.g. behind a proxy).
# DOCKER_BUILD_FLAGS=

DOMAIN=time2live.xyz
ACME_EMAIL=you@example.com
PUBLIC_BASE_URL=https://time2live.xyz

POSTGRES_USER=time2live
POSTGRES_DB=time2live
# hex only (it is embedded in DATABASE_URL): openssl rand -hex 32
POSTGRES_PASSWORD=

# openssl rand -base64 32 — losing it makes stored job headers and webhook secrets unreadable.
ENCRYPTION_KEY=

LOG_LEVEL=info
# This server's public IPv4/IPv6 (webhooks may never target them).
SERVER_PUBLIC_IPS=
SIWE_CHAIN_IDS=8453,84532
# Optional: smart-wallet (ERC-1271/6492) sign-in
# BASE_RPC_URL=https://mainnet.base.org
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional Telegram alerts (all three together), then: docker compose exec api node dist/bin/admin.js telegram-webhook
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=

# Email alerts via an external provider (Resend-compatible HTTP API). Independent transport/infra
# from webhooks and Telegram, so a downstream channel being down cannot silence a dead-agent alert.
# ALERT_EMAIL_FROM is required when RESEND_API_KEY is set.
# RESEND_API_KEY=
# ALERT_EMAIL_FROM=time2live <alerts@time2live.xyz>
# EMAIL_API_BASE=https://api.resend.com

# x402 payments (USDC on Base). Off: quotas still apply and over-quota calls get a plain 402.
# The public x402.org facilitator serves testnets only (eip155:84532 = Base Sepolia).
# Base mainnet (eip155:8453) needs another facilitator, e.g. Coinbase CDP, plus its auth header.
# X402_ENABLED=true
# X402_NETWORK=eip155:84532
# X402_PAY_TO=0xYourReceivingWallet
# X402_FACILITATOR_URL=https://x402.org/facilitator
# X402_FACILITATOR_AUTHORIZATION=Bearer …

# Keeper for the on-chain DeadMansSwitch (docs/OPERATIONS.md §8c). The factory address is the
# same on every chain (deterministic deploy). KEEPER_PRIVATE_KEY is a hot wallet holding only a
# few dollars of ETH for gas.
# KEEPER_ENABLED=true
# KEEPER_CHAIN_ID=84532
# KEEPER_RPC_URL=https://sepolia.base.org
# KEEPER_FACTORY_ADDRESS=0x…
# KEEPER_FROM_BLOCK=0
# KEEPER_PRIVATE_KEY=0x…

# Dogfooding: ping URL of the operator "worker" monitor (docs/OPERATIONS.md §6).
# SELF_HEARTBEAT_URL=https://time2live.xyz/v1/heartbeat/mon_…
